{
  "name": "mymusic-desktop",
  "version": "1.0.0",
  "description": "MyMusic 桌面客户端",
  "main": "main.js",
  "author": "CodeFlyDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeFlyDev/MyMusic.git"
  },
  "scripts": {
    "build:icon": "node build-icon.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.mymusic.desktop",
    "productName": "MyMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "settings.html",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MyMusic"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.0",
    "sharp": "^0.33.5"
  }
}
